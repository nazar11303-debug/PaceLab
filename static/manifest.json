{
    "name": "PaceLab — аналіз бігу",
    "short_name": "PaceLab",
    "description": "Персональна аналітика бігових тренувань: маршрути, пульсові зони, форма та втома, рекорди.",
    "lang": "uk",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#0d1117",
    "theme_color": "#0d1117",
    "categories": [
        "health",
        "fitness",
        "sports"
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "file",
                    "accept": [
                        "application/gpx+xml",
                        "application/octet-stream",
                        ".gpx",
                        ".fit"
                    ]
                }
            ]
        }
    },
    "icons": [
        {
            "src": "/static/logo.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/logo.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/logo.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
